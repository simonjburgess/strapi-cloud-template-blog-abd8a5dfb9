{
  // Bet Angel Professional local API. Enable it in Bet Angel: Settings > API.
  "BetAngel": {
    "BaseUrl": "http://localhost:9000",
    "PollIntervalMs": 1000,
    "MarketRefreshSeconds": 30,
    "MarketDataRequired": [ "ID", "NAME", "MARKET_TYPE", "SELECTION_IDS", "SELECTION_NAMES" ],
    "PriceDataRequired": [ "LAST_TRADED_PRICE", "BEST_PRICE_ONLY", "VOLUME" ]
  },

  // Which loaded markets to watch, and which selection to back.
  "Markets": {
    "MarketTypePrefixes": [ "OVER_UNDER" ],
    "MarketNameContains": [ "Over/Under" ],
    "SelectionNamePrefix": "Over"
  },

  "Signal": {
    "ShortWindowSeconds": 10,
    "BaselineWindowSeconds": 300,
    "WarmupSeconds": 120,
    "SpikeMultiplier": 3.0,
    "MinShortWindowVolume": 500,
    "MinTicksShortened": 2,
    "MinOverPrice": 1.5,
    "MaxOverPrice": 6.0,
    "GoalPriceThreshold": 1.10,
    "CooldownSeconds": 180
  },

  "Trading": {
    // "Paper" simulates everything. "Live" places real bets.
    "Mode": "Paper",
    "Stake": 2.0,
    // Ask for a price this many ticks below the best back price (better chance of a match).
    "EntryTicksBelowBest": 0,
    // Paper mode: mimic Betfair's in-play bet delay (football is about 5s).
    "PaperFillDelaySeconds": 5,
    "MaxOpenPositions": 1,
    "ExitAfterSeconds": 90,
    "CommissionRate": 0.05,
    "MaxSessionLoss": 20.0,
    "LiveAutoExit": false
  },

  // JSON field names tried, in order, when reading Bet Angel responses.
  // Run "dotnet run -- --dump" and edit these if values come back blank.
  "Fields": {
    "MarketId": [ "id", "marketId" ],
    "MarketName": [ "name", "marketName" ],
    "MarketType": [ "marketType", "type" ],
    "MarketStatus": [ "status", "marketStatus" ],
    "MarketVolume": [ "totalMatched", "volume", "tradedVolume", "matched" ],
    "Selections": [ "selections", "runners" ],
    "SelectionId": [ "id", "selectionId" ],
    "SelectionName": [ "name", "selectionName" ],
    "SelectionVolume": [ "totalMatched", "volume", "tradedVolume", "matched" ],
    "LastTradedPrice": [ "lastTradedPrice", "ltp", "lastPriceTraded", "lastTraded" ],
    "BackPrices": [ "backPrices", "availableToBack", "bestBackPrices", "back" ],
    "LayPrices": [ "layPrices", "availableToLay", "bestLayPrices", "lay" ],
    "Price": [ "price", "odds" ],
    "SuspendedStatusContains": [ "SUSPEND", "CLOSED" ]
  },

  "LogDirectory": "logs"
}
