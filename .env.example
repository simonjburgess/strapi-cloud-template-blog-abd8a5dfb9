HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# --- HeyGen LiveAvatar (live talking avatar at /anson/) ------------------------
# API key from the developers page at https://app.liveavatar.com
# Server-side secret: it is never sent to the browser.
LIVEAVATAR_API_KEY=

# Which avatar and voice to stream.
# List the options with: npm run liveavatar -- avatars
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=

# Knowledge base / system prompt. Leave blank and one is created from the
# bundled George Anson persona on first use, or run:
#   npm run liveavatar -- push-context
LIVEAVATAR_CONTEXT_ID=

# FULL = HeyGen runs the LLM, speech recognition and speech synthesis.
# LITE = you bring your own conversational stack; HeyGen only streams the face.
LIVEAVATAR_MODE=FULL
LIVEAVATAR_LANGUAGE=en

# Sandbox sessions are watermarked but do not consume streaming credits.
LIVEAVATAR_SANDBOX=false

# Hard cap in seconds so an abandoned kiosk session cannot burn credits.
LIVEAVATAR_MAX_SESSION_DURATION=600

# Per-IP limit on the billable session-token endpoint.
LIVEAVATAR_RATE_LIMIT_MAX=10
LIVEAVATAR_RATE_LIMIT_WINDOW_MS=60000
